{
  "name": "server-essential",
  "version": "1.0.0",
  "description": "",
  "author": "JustIn Consotium",
  "license": "BSD-3-Clause",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "type-check": "tsc --watch --noEmit -p tsconfig.json",
    "dev-run": "nodemon --exec \"node --env-file=.env --import tsx/esm src/index.ts\"",
    "dev": "npm-run-all --parallel type-check dev-run",
    "dev-old": "pnpm build && node --env-file=.env -r source-map-support/register dist/index.js",
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "packageManager": "pnpm@11.5.1",
  "dependencies": {
    "@just-in/server": "github:justin-consortium/justin-server#jst-187-websocket",
    "@justin-consortium/core": "^0.3.2",
    "better-auth": "^1.6.18",
    "papaparse": "^5.5.3"
  },
  "peerDependencies": {
    "mongodb": "^6.0.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.1",
    "@types/papaparse": "^5.5.2",
    "@types/source-map-support": "^0",
    "@vitest/coverage-v8": "^4.1.8",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.3",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "source-map-support": "^0.5.21",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
