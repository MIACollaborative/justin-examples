{
  "name": "server-essential",
  "version": "1.0.0",
  "description": "",
  "author": "JustIn Consotium",
  "license": "BSD-3-Clause",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "type-check": "tsc --watch --noEmit -p tsconfig.json",
    "dev-run": "nodemon --exec tsx src/index.ts",
    "dev": "npm-run-all --parallel type-check dev-run",
    "dev-old": "pnpm build && node --env-file=.env -r source-map-support/register dist/index.js",
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js"
  },
  "packageManager": "pnpm@11.5.1",
  "dependencies": {
    "@just-in/server": "git+ssh://git@github.com/justin-consortium/justin-server.git#jst-111-2-add-tests",
    "@justin-consortium/core": "^0.3.2"
  },
  "peerDependencies": {
    "mongodb": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/source-map-support": "^0",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "source-map-support": "^0.5.21",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
