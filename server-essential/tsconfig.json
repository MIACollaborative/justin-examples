{
  "compilerOptions": {
    "target": "es2022",
    "module": "ESNext", // Change from "commonjs" to "ESNext"
    "moduleResolution": "node", // Add this for proper module resolution
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "./",
    "typeRoots": [
      "./node_modules/@types",
    ]
  },
  "include": ["src/**/*"]
}
